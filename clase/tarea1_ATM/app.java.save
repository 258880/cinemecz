import java.util.ArrayList; //importa el array
import java.util.Scanner; //basicamente un escáner

public class app
{
    public static void main(String[] args) throws Exception
    {

        Scanner scanner = new Scanner(System.in); //deteccion del imput del teclado

        System.out.println("Bienvenido al cajero automático"); 

        while(true)

	    {

		System.out.println("1. Iniciar sesión");
		System.out.println("2. Salir");
		System.out.print("Selecciona una opción: ");

		int option = scanner.nextInt();

		switch (option)
		    
		    {
			
		    case 1:
			
			{
			    ArrayList<Account> cuentas = Account.usuario.rCuenta(); //accede al array de cuentas 

			  
				    
			    System.out.print("Ingrese su número de cuenta: ");
			    String numCuenta = scanner.nextLine();

			    System.out.println("Ingresa tu nip");
			    String pin = scanner.nextLine();
			    
			    for(int i = 0; i < cuentas.size() ; i++)
				{
				    funciones cuentaAct = cuentas.get(i);
				    
				    if(cuentaAct.rNumCuenta().equals(numCuenta) &&
				       cuentaAct.rPin().equals(pin) &&
				       cuentaAct.rActivo().equals(true)) // equals es usado en vez de "==" por que estoy manejando las variables que no serán modificadas con operandos como strigs
					{
					    System.out.println("Bienvenido, " + account.rNombre());
					    op_menu.main(scanner, account.getName(), account.());
					    break; 
					}
				    else
					{
					    if(!(cuentaAct.rNumCuenta().equals(numCuenta) &&
						 cuentaAct.rPin().equals(pin)))
						{
						    System.out.println("numero de cuenta y/o nip erróneos, intenta nuevamete");
						}
					    else
						{
						    if(cuentaAct.rNumCuenta().equals(numCuenta) &&
						       cuentaAct.rPin().equals(pin) &&
						       cuentaAct.rActivo().equals(false))
							{
							    System.out.println("numero de cuenta y/o nip erróneos, intenta nuevamete");
							}
						}
							    
					}
				}
			}
			    
	    case 2:
		System.out.println("Saliendo...\n\n");
		return;

	    default:
		System.out.println("Opción no válida. Por favor, intenta de nuevo.\n\n");
		break;
	    }
    }
}


public class menu
{
    public void javier(Scanner scanner, String nombre, float balance)
    {

	System.out.println("Menú de operaciones");

	while(true)
	    {

	    System.out.println("1. Consultar saldo");
	    System.out.println("2. Retirar dinero");
	    System.out.println("3. Depositar dinero");
	    System.out.println("4. Salir");
	    System.out.print("Selecciona una opción: ");

	    int option = scanner.nextInt();

	    switch (option)
		{
	    case 1:
		balanceCheck.main(nombre, balance);
		break;
	    case 2:
		withdraw.main(scanner, nombre, balance);
		break;
	    case 3:
		deposit.main(scanner, nombre, balance);
		break;
	    case 4:
		System.out.println("Regresando al menú principal\n\n");
		return;
	    default:
		System.out.println("Opción no válida. Por favor, intenta de nuevo.\n\n");
	    }
	}
    }
}


public class balance
{
    public static void main(String name, float balance)
    {

	System.out.println("\n" + nombre + ", tu saldo actual es: " + balance + "\n\n");
    }
}


public class retiro
{
    public static void main(Scanner scanner, String name, float balance)
    {

	System.out.print("Ingrese la cantidad a retirar: ");
	float cant = scanner.nextFloat();

	if (cant > balance) {
	    System.out.println("Fondos insuficientes. Su saldo actual es: " + balance);

	} else
	    {
	    balance -= amount; //-= es lo mismo que poner balance  = (balance - amount)
	    System.out.println("Retiro exitoso.");
	    printTicket.main(scanner, name, balance);
	}
    }
}


public class deposit
{
    public static void main(Scanner scanner, String nombre, float balance)
    {

	System.out.print("Ingrese la cantidad a depositar: ");
